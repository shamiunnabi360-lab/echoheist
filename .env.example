# Echo Heist — environment
#
# Canonical origin used by SEO metadata and social preview images. Set this to
# the production URL (custom domain if you have one). On Vercel, preview builds
# fall back to VERCEL_URL automatically when this is unset.
# Example: https://echoheist.vercel.app
NEXT_PUBLIC_SITE_URL=
#
# Leaderboard storage and rate limiting use Vercel KV (Upstash Redis) through
# its REST API. Create a KV/Redis database, then either:
#   vercel env pull .env.local
# or paste the REST credentials from the Upstash console.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash-native names are also accepted as aliases.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Mixed into the SHA-256 hash of client IPs before rate-limit keys
# are written, so raw IPs never reach the store. Set a private value in prod.
RATE_LIMIT_SALT=

# Behavior:
#  - development: with no credentials, an in-process memory store is used so
#    both API routes work locally (scores reset when the dev server restarts).
#  - production: credentials are required; the API returns 503 without them.
